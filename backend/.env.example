DATABASE_URL=sqlite:///./pawfectpal.db
SECRET_KEY=replace-with-a-long-random-local-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
DOG_API_KEY=replace-with-your-dog-api-key
CAT_API_KEY=replace-with-your-cat-api-key
# Optional shared fallback if your provider uses one key for multiple pet APIs.
PETS_API_KEY=replace-with-your-shared-pet-api-key

FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"example"}

ENVIRONMENT=development
DEBUG=true
ENABLE_AI_CHATBOT=true
ENABLE_GOOGLE_AUTH=true
RUN_MIGRATIONS_ON_STARTUP=false
